skip_docs

ROOT = File.expand_path("..", Dir.pwd)
AAB = File.join(ROOT, "android/app/build/outputs/bundle/release/app-release.aab")
IPA = File.join(ROOT, "ios/build/ipa/sowocial.ipa")

platform :android do
  desc "Build the signed release AAB"
  lane :build do
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: File.join(ROOT, "android"),
      flags: "--console=plain --max-workers=1",
      properties: {
        "reactNativeArchitectures" => "arm64-v8a,x86_64",
        "android.injected.signing.store.file" => ENV.fetch("ANDROID_KEYSTORE_PATH"),
        "android.injected.signing.store.password" => ENV.fetch("ANDROID_KEY_PASSWORD"),
        "android.injected.signing.key.alias" => ENV.fetch("ANDROID_KEY_ALIAS"),
        "android.injected.signing.key.password" => ENV.fetch("ANDROID_KEY_PASSWORD"),
      }
    )
  end

  desc "Upload an AAB to Google Play (options: aab, track)"
  lane :upload do |options|
    upload_to_play_store(
      json_key_data: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON"),
      aab: options.fetch(:aab, AAB),
      track: options.fetch(:track, "internal"),
      metadata_path: "metadata/android",
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end

platform :ios do
  desc "Build the signed App Store IPA"
  lane :build do
    signing = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath", ENV.fetch("APPLE_API_KEY_PATH"),
      "-authenticationKeyID", ENV.fetch("APPLE_API_KEY"),
      "-authenticationKeyIssuerID", ENV.fetch("APPLE_API_ISSUER"),
    ].shelljoin
    # Archive with the Apple Distribution certificate already in the login keychain;
    # the generated project defaults to a development identity, which the build Mac doesn't have.
    distribution = "CODE_SIGN_IDENTITY=#{"Apple Distribution".shellescape}"
    build_app(
      workspace: File.join(ROOT, "ios/sowocial.xcworkspace"),
      scheme: "sowocial",
      configuration: "Release",
      export_method: "app-store",
      skip_profile_detection: true,
      archive_path: File.join(ROOT, "ios/build/sowocial.xcarchive"),
      derived_data_path: File.join(ROOT, "ios/build/derived"),
      output_directory: File.dirname(IPA),
      output_name: File.basename(IPA, ".ipa"),
      xcargs: "#{signing} #{distribution}",
      export_xcargs: signing
    )
  end

  desc "Upload an IPA to TestFlight (options: ipa)"
  lane :upload do |options|
    app_store_connect_api_key(
      key_id: ENV.fetch("APPLE_API_KEY"),
      issuer_id: ENV.fetch("APPLE_API_ISSUER"),
      key_filepath: ENV.fetch("APPLE_API_KEY_PATH")
    )
    upload_to_testflight(
      ipa: options.fetch(:ipa, IPA),
      skip_waiting_for_build_processing: true
    )
  end

  desc "Update the App Store listing, age rating and review information"
  lane :metadata do
    app_store_connect_api_key(
      key_id: ENV.fetch("APPLE_API_KEY"),
      issuer_id: ENV.fetch("APPLE_API_ISSUER"),
      key_filepath: ENV.fetch("APPLE_API_KEY_PATH")
    )
    upload_to_app_store(
      app_version: ENV.fetch("SOWOCIAL_VERSION"),
      metadata_path: File.join(ROOT, "fastlane/metadata/ios"),
      app_rating_config_path: File.join(ROOT, "fastlane/age_rating.json"),
      app_review_information: {
        demo_user: ENV.fetch("APP_REVIEW_DEMO_USER", nil),
        demo_password: ENV.fetch("APP_REVIEW_DEMO_PASSWORD", nil)
      }.compact,
      skip_binary_upload: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      force: true
    )
  end

  desc "Publish the App Privacy answers (Apple ID, run once)"
  lane :privacy do
    upload_app_privacy_details_to_app_store(
      app_identifier: "eu.owops.sowocial",
      json_path: File.join(ROOT, "fastlane/app_privacy.json")
    )
  end
end
