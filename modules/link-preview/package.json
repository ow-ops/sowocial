{
  "name": "sowocial-link-preview",
  "version": "0.1.0",
  "description": "Link previews from sable-link-preview, as a React Native turbo module",
  "homepage": "https://git.sable.moe/SableClient/link-preview",
  "repository": { "url": "https://git.sable.moe/SableClient/link-preview" },
  "license": "AGPL-3.0-or-later",
  "author": "ow-ops",
  "private": true,
  "main": "src/index.tsx",
  "react-native": "src/index.tsx",
  "types": "src/index.tsx",
  "scripts": {
    "ubrn:ios": "ubrn build ios --config ubrn.config.yaml --and-generate --release",
    "ubrn:android": "ubrn build android --config ubrn.config.yaml --and-generate --release"
  },
  "dependencies": {
    "@ubjs/core": "0.31.0-8",
    "uniffi-bindgen-react-native": "0.31.0-8"
  },
  "peerDependencies": {
    "react-native": "*"
  },
  "codegenConfig": {
    "name": "RNSowocialLinkPreviewSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": { "javaPackageName": "eu.owops.sowocial.linkpreview" }
  }
}
